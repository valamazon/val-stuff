---
import Header from "../components/Header.astro";
import PageEntrance from "../components/PageEntrance.astro";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { galleries } from "../data/galleries";
import "../styles/foundation.css";
import "../styles/home.css";
import "../styles/utilities.css";

interface Props {
  title: string;
  description?: string;
  active?: "home" | "about" | "photos" | "projects";
  home?: boolean;
  image?: string | ImageMetadata;
  imageAlt?: string;
}

const {
  title,
  description = "Photography and writing by Val Lamazon",
  active,
  home = false,
  image,
  imageAlt,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imagePath = typeof image === "string" ? image : image?.src;
const socialImage = imagePath ? new URL(imagePath, Astro.site) : undefined;
const galleryCovers = await Promise.all(galleries.map((gallery) => getImage({
  src: gallery.cover,
  width: 1280,
  format: "webp",
  quality: 80,
})));
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={home ? "#8c3434" : "#fffefa"} />
    <link rel="preload" href="/fonts/Kabel-Light.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/images/home-background.webp" as="image" type="image/webp" fetchpriority="high" />
    {galleryCovers.map((cover) => <link rel="preload" href={cover.src} as="image" />)}
    <link rel="canonical" href={canonical} />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon/favicon-16x16.png" />
    <link rel="manifest" href="/images/favicon/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — valstuff`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {typeof image !== "string" && image && <meta property="og:image:width" content={String(image.width)} />}
    {typeof image !== "string" && image && <meta property="og:image:height" content={String(image.height)} />}
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={`${title} — valstuff`} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <title>{title} — valstuff</title>
    <ClientRouter fallback="swap" />
  </head>
  <body class:list={{ home, interior: !home, "page-enter-pending": true }}>
    <PageEntrance />
    <Header home={home} active={active} />
    <main>
      <slot />
    </main>
  </body>
</html>
