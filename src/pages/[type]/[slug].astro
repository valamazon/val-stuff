---
import PhotoAlbum from "../../components/PhotoAlbum.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { galleries } from "../../data/galleries";

export function getStaticPaths() {
  return galleries.map((gallery) => ({
    params: {
      type: gallery.type,
      slug: gallery.slug,
    },
    props: { gallery },
  }));
}

const { gallery } = Astro.props;
---

<SiteLayout
  title={gallery.title}
  active={gallery.type}
  image={gallery.cover}
  imageAlt={`Cover image for ${gallery.title}`}
  description={`${gallery.title}, a ${gallery.type === "photos" ? "photo series" : "project"} by Val Lamazon`}
>
  <PhotoAlbum gallery={gallery} />
</SiteLayout>
